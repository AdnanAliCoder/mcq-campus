# Django
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Supabase PostgreSQL: Dashboard -> Connect -> Transaction pooler is recommended for Vercel serverless.
# Example only. Never commit the real password. Transaction pooler normally uses port 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional temporary performance diagnostics. Logs endpoint timing/query counts only; never credentials or request bodies.
PERFORMANCE_LOGGING=false

# Optional Redis cache for a persistent server. Keep Redis bound to localhost on the Oracle VM.
REDIS_URL=redis://127.0.0.1:6379/1

# Public SEO/canonical host. The default Vercel project hostname is permanently redirected here.
PUBLIC_CANONICAL_HOST=www.mcqcampus.com
VERCEL_DEFAULT_HOST=mcq-campus.vercel.app

# Owner account: only the explicit ensure_superadmin command creates/updates it.
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=change-this-before-deploy
SUPERADMIN_NAME=MCQCampus Owner

# Optional email provider. Console backend is used if these are empty.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@mcqcampus.local

# Authentication / OTP security (optional; safe defaults shown)
EMAIL_VERIFICATION_CODE_EXPIRY_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_ENABLED=true
