# Django
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Supabase PostgreSQL: Dashboard -> Connect -> Session pooler is recommended for this Django app.
# Example only. Never commit the real password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# First owner account. The management command creates/updates it during deploy.
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=change-this-before-deploy
SUPERADMIN_NAME=MCQ Campus Owner

# Optional email provider. Console backend is used if these are empty.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@mcqcampus.local
